# Copy to .env for local runs. On GitHub, add these as repository secrets instead
# (Settings → Secrets and variables → Actions). Never commit real values.

# Email (required for the daily briefing)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=16-character-app-password
GMAIL_TO=you@gmail.com

# AI (at least one; Groq is the primary, Gemini the backup)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional channels
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
DASHBOARD_URL=
PORT=8050
